# 默认按文本处理，交给 git 的 eol 决策
* text=auto

# 脚本必须是 LF。Windows 上检出若变成 CRLF，Linux 下 sh 会直接崩
# （arg0 \r 报 "not found"），而本项目的安装入口就是 sh 脚本。
*.sh text eol=lf
install.sh text eol=lf

# 引擎生成器是在设备上执行的 Python，同样强制 LF：
# CRLF 会让 shebang 行带上 \r，直接执行时报错。
*.py text eol=lf

# 引擎表是 UTF-8 中文文本，保持 LF 以免 uim 读到 \r
*.scm text eol=lf

# 词频表同理
data/frequency.txt text eol=lf
*.txt text eol=lf

# 文档同样强制 LF：不然 Windows 检出成 CRLF，每次 commit 都刷
# "LF will be replaced by CRLF" 警告，噪声盖住真正需要注意的信息。
*.md text eol=lf

# 二进制，明确不打行尾转换
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.7z binary