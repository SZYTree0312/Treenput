# 默认按文本处理，交给 git 的 eol 决策
* text=auto

# 脚本必须是 LF。Windows 上检出若变成 CRLF，Linux 下 sh 会直接崩
# （arg0 \r 报 "not found"），而本项目的安装入口就是 sh 脚本。
*.sh text eol=lf
install.sh text eol=lf

# 引擎表是 UTF-8 中文文本，保持 LF 以免 uim 读到 \r
*.scm text eol=lf

# 词频表同理
data/frequency.txt text eol=lf
*.txt text eol=lf

# 二进制，明确不打行尾转换
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.7z binary